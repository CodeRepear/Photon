<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Photon.Views.VideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch" Margin="8,8,8,0">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search videos..." Width="260" QueryIcon="Find" TextChanged="OnSearchChanged"/>
                    <ComboBox x:Name="SortCombo" Width="150" SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="Newest first" Tag="DateDesc" IsSelected="True"/>
                        <ComboBoxItem Content="Oldest first" Tag="DateAsc"/>
                        <ComboBoxItem Content="Name A-Z" Tag="NameAsc"/>
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <ScrollViewer Grid.Row="1" x:Name="VideoScroll" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto" SizeChanged="OnScrollSizeChanged">
            <StackPanel x:Name="VideoRoot"/>
        </ScrollViewer>

        <Border x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="▶" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No videos found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Add a folder containing videos to get started." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
