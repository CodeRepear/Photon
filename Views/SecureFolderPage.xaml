<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Photon.Views.SecureFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnPageLoaded"
    Background="#1A1A1A">

    <Grid>
        <!-- Lock screen (shown when vault is locked) -->
        <Grid x:Name="LockScreen" Background="#1A1A1A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="360">
                <!-- Lock icon -->
                <Border Width="80" Height="80" CornerRadius="40" Background="#2D2D2D"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="32" Foreground="#64B5F6" 
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Secure Folder" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock x:Name="LockSubtitle" Text="Enter your password to unlock"
                           FontSize="13" Foreground="#88FFFFFF" HorizontalAlignment="Center"/>

                <PasswordBox x:Name="PasswordBox" PlaceholderText="Password"
                             Width="300" HorizontalAlignment="Center"
                             KeyDown="OnPasswordKeyDown" Background="#2D2D2D" Foreground="White"/>

                <Button x:Name="AuthButton" Content="Unlock" Click="OnAuthClick"
                        Width="300" HorizontalAlignment="Center"
                        Background="#0D47A1" Foreground="White"/>

                <TextBlock x:Name="AuthError" Text="" Foreground="#FF5252"
                           FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,0">
                    <HyperlinkButton x:Name="ForgotLink" Content="Reset vault" Click="OnResetVaultClick"
                                      Foreground="#64B5F6" FontSize="12"/>
                    <HyperlinkButton x:Name="WindowsHelloBtn" Content="Use Windows Hello" Click="OnWindowsHelloClick"
                                      Foreground="#64B5F6" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Unlocked content -->
        <!-- Unlocked content -->
        <Grid x:Name="UnlockedContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="12,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="6" Background="Transparent"
                            Tapped="OnLockTap" ToolTipService.ToolTip="Lock vault">
                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="#64B5F6"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="Secure Folder" VerticalAlignment="Center"
                               FontSize="14" Foreground="#CCFFFFFF" FontWeight="SemiBold" Margin="8,0,0,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Border Width="36" Height="36" CornerRadius="6" Background="Transparent"
                                Tapped="OnImportTap" ToolTipService.ToolTip="Import files"
                                PointerEntered="OnToolBtnEnter" PointerExited="OnToolBtnExit">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" Foreground="#8BC34A"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="6" Background="Transparent"
                                Tapped="OnChangePasswordTap" ToolTipService.ToolTip="Change password"
                                PointerEntered="OnToolBtnEnter" PointerExited="OnToolBtnExit">
                            <FontIcon Glyph="&#xE8AC;" FontSize="14" Foreground="#FFB74D"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Info bar -->
            <Border Grid.Row="1" Background="#161616" Padding="16,8">
                <TextBlock x:Name="VaultInfoLabel" Text="0 items in vault"
                           FontSize="12" Foreground="#88FFFFFF"/>
            </Border>

            <!-- River Flow Gallery -->
            <ScrollViewer Grid.Row="2" x:Name="SecureScroll" Padding="16" VerticalScrollBarVisibility="Auto" SizeChanged="OnScrollSizeChanged">
                <StackPanel x:Name="SecureRoot"/>
            </ScrollViewer>
        </Grid>

        <!-- Full Screen Decrypted Image Overlay -->
        <Grid x:Name="SecureViewerOverlay" Visibility="Collapsed" Background="Black">
            <Image x:Name="SecureFullImage" Stretch="Uniform" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" Spacing="8">
                <Button Content="Close" Click="OnCloseSecureViewer" Background="#40FFFFFF" Foreground="White" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>