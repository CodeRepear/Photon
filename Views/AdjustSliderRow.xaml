<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Photon.Views.AdjustSliderRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="0">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="LabelText" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="ValueText" FontSize="11" Foreground="#88FFFFFF"
                       VerticalAlignment="Center" Width="34" TextAlignment="Right"/>
        </Grid>
        <Slider x:Name="ValueSlider" StepFrequency="0.01" ValueChanged="OnSliderValueChanged"
                Width="320" HorizontalAlignment="Left"
                DoubleTapped="OnSliderDoubleTapped" ToolTipService.ToolTip="Double-click to reset"/>
    </StackPanel>
</UserControl>
